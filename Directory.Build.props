<Project>
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <Version Condition="'$(Version)' == ''">0.3.0-dev</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.3.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Product>TeXShift</Product>
    <Authors>Victor-Quqi</Authors>
    <Copyright>Copyright © 2025-2026</Copyright>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TeXShiftSigningKeyPath Condition="'$(TeXShiftSigningKeyPath)' == ''">$(MSBuildThisFileDirectory)texshift_key.snk</TeXShiftSigningKeyPath>
    <SignAssembly Condition="Exists('$(TeXShiftSigningKeyPath)')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true'">$(TeXShiftSigningKeyPath)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
