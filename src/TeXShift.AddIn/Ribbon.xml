<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
    <ribbon>
        <tabs>
            <tab id="tabTeXShift" getLabel="GetTabLabel">
                <group id="grpConvertTools" getLabel="GetGroupLabel">
                    <button id="btnSilentConvert"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnConvertButtonClick"
                            imageMso="Repeat" />
                    <button id="btnReverseConvert"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnReverseConvertButtonClick"
                            imageMso="Undo" />
                </group>
                <group id="grpDebugTools" getLabel="GetGroupLabel" getVisible="GetDebugGroupVisible">
                    <button id="btnDebugConvert"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnDebugConvertButtonClick"
                            imageMso="EndOfLine" />
                    <button id="btnDebugReverseConvert"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnDebugReverseConvertButtonClick"
                            imageMso="StartOfLine" />
                    <button id="btnDebugXml"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnDebugXmlButtonClick"
                            imageMso="SaveSelectionToTableOfContentsGallery" />
                    <button id="btnDebugSelectionXml"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnDebugSelectionXmlButtonClick"
                            imageMso="SaveSelectionToHeaderGallery" />
                </group>
                <group id="grpSettings" getLabel="GetGroupLabel">
                    <button id="btnSettings"
                            getLabel="GetButtonLabel"
                            size="large"
                            onAction="OnSettingsButtonClick"
                            imageMso="ComAddInsDialog" />
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
