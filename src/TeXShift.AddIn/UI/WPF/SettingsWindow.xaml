<Window x:Class="TeXShift.AddIn.UI.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TeXShift.AddIn.UI.WPF.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding WindowTitle}"
        Width="780" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/TeXShift.AddIn;component/Resources/TeXShift.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Purple"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <Style x:Key="SettingsNavigationItem" TargetType="TabItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="Highlight" CornerRadius="6" Opacity="0"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <Border x:Name="FocusBorder" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter x:Name="Header" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Border>
                                <Border x:Name="Indicator" Width="3" Margin="0,10" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Visibility="Collapsed"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Highlight" Property="Opacity" Value="0.06"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Highlight" Property="Opacity" Value="0.12"/>
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsNavigation" TargetType="TabControl">
                <Setter Property="TabStripPlacement" Value="Left"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
                                    </ScrollViewer>
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" Margin="8,0,0,0"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="130"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Small button style -->
            <Style x:Key="SmallOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="MinWidth" Value="76"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Compact outlined fields: avoid explicit Height to prevent clipping/preview issues -->
            <sys:Double x:Key="CompactFieldMinHeight">32</sys:Double>

            <Style x:Key="CompactOutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="MinHeight" Value="{StaticResource CompactFieldMinHeight}"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0"/>
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="MinHeight" Value="{StaticResource CompactFieldMinHeight}"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0"/>
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed"/>
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tab Control -->
        <TabControl Grid.Row="0" Style="{StaticResource SettingsNavigation}">
            <TabItem Header="{Binding TabGeneralHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                        <materialDesign:Card Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LanguageLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="DisplayName" Width="180" HorizontalAlignment="Left"/>
                                </Grid>
                                <CheckBox Content="{Binding ShowPasteConvertButtonText}" IsChecked="{Binding ShowPasteConvertButton}"
                                          Margin="0,20,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                </ScrollViewer>
            </TabItem>

            <!-- Style Tab -->
            <TabItem Header="{Binding TabStyleHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                    <StackPanel>
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding MathSectionTitle}" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MathDisplayModeLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Width="230" ItemsSource="{Binding MathDisplayModes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DisplayMathMode, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MathDisplayModeDescription}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayMathFontSizeLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Width="140" Minimum="8" Maximum="36" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding MathFontSize}"/>
                                    <TextBlock Text="{Binding MathFontSize, StringFormat={}{0:F1} pt}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding QuoteBlockSectionTitle}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BackgroundColorLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding QuoteBlockBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="{Binding SelectButtonText}" Click="PickQuoteBlockBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding HeadingSizeSectionTitle}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8">
                                        <TextBlock Text="H1"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H1FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H1FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="H2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H2FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H2FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,8">
                                        <TextBlock Text="H3"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H3FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H3FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="H4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H4FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H4FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="H5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H5FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H5FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="H6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H6FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H6FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding HorizontalRuleSectionTitle}" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="{Binding HorizontalRuleUseImageText}" IsChecked="{Binding HorizontalRuleUseImage}"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Code Block Tab -->
            <TabItem Header="{Binding TabCodeBlockHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                    <StackPanel>
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding CodeBlockSectionTitle}" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BackgroundColorLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding CodeBlockBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="{Binding SelectButtonText}" Click="PickCodeBlockBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TextColorLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding CodeBlockTextColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="{Binding SelectButtonText}" Click="PickCodeBlockTextColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FontLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding CodeBlockFontFamily}"
                                              Width="180" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FontSizeLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="8" Maximum="24" Value="{Binding CodeBlockFontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CodeBlockFontSize, StringFormat={}{0:F1} pt}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LineSpacingLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="12" Maximum="36" Value="{Binding CodeBlockSpaceBetween}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CodeBlockSpaceBetween, StringFormat={}{0:F1} pt}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>

                                <CheckBox Content="{Binding EnableSyntaxHighlightText}" IsChecked="{Binding EnableSyntaxHighlight}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding InlineCodeSectionTitle}" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BackgroundColorLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding InlineCodeBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="{Binding SelectButtonText}" Click="PickInlineCodeBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FontLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding InlineCodeFontFamily}"
                                              Width="180" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Mermaid Tab -->
            <TabItem Header="{Binding TabMermaidHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                    <StackPanel>
                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding MermaidSectionTitle}" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ThemeLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMermaidThemes}" SelectedItem="{Binding MermaidTheme}"
                                              Width="180" HorizontalAlignment="Left"/>
                                </Grid>

                                <!-- Theme preview on a white page background, as in OneNote -->
                                <Border Height="132" Margin="0,0,0,12" Padding="8" CornerRadius="4"
                                        Background="White" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                        DataContext="{Binding MermaidPreview}" IsVisibleChanged="MermaidPreview_IsVisibleChanged"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                                                     Width="24" Height="24"
                                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding MaxWidthLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="640" Maximum="3840" Value="{Binding MermaidMaxWidth}" TickFrequency="64" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MermaidMaxWidth}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding MaxHeightLabel}" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="480" Maximum="2160" Value="{Binding MermaidMaxHeight}" TickFrequency="48" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MermaidMaxHeight}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Debug Tab -->
            <TabItem Header="{Binding TabDebugHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                    <StackPanel>
                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <CheckBox Content="{Binding TryRecognizeNonTeXShiftFormatsText}" IsChecked="{Binding TryRecognizeNonTeXShiftFormats}" Margin="0,0,0,12"/>
                                <CheckBox Content="{Binding ShowDebugButtonsText}" IsChecked="{Binding ShowDebugButtons}" Margin="0,0,0,12"/>
                                <CheckBox Content="{Binding ExportPdfText}" IsChecked="{Binding ExportPdf}" Margin="0,0,0,12"/>
                                <CheckBox Content="{Binding DumpFullPageXmlText}" IsChecked="{Binding DumpFullPageXml}" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding DebugOutputPathDescription}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding DebugOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{Binding DefaultDebugOutputPath}"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource CompactOutlinedTextBox}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="{Binding BrowseButtonText}" Click="BrowseFolder_Click"
                                            Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>
                                <TextBlock Text="{Binding RuntimeLogPathDescription}" TextWrapping="Wrap" Margin="0,16,0,4"/>
                                <TextBlock Text="{Binding RuntimeLogPath}" Opacity="0.7" TextWrapping="Wrap"
                                           IsEnabled="False"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding ResetDefaultsButtonText}" Click="ResetButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="{Binding CancelButtonText}" IsCancel="True" Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="{Binding OkButtonText}" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        </Grid>

        <!-- Dialog Overlay -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed">
            <!-- Semi-transparent backdrop -->
            <Border Background="#66000000" MouseDown="DialogOverlay_MouseDown"/>

            <!-- Card without shadow -->
            <materialDesign:Card x:Name="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Padding="24" MinWidth="280"
                                 materialDesign:ElevationAssist.Elevation="Dp0"
                                 RenderTransformOrigin="0.5,0.5">
                <materialDesign:Card.RenderTransform>
                    <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/>
                </materialDesign:Card.RenderTransform>
                <StackPanel>
                    <TextBlock Text="{Binding ResetDialogTitle}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding ResetDialogMessage}"
                               TextWrapping="Wrap"
                               MaxWidth="300"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="{Binding CancelButtonText}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="DialogCancel_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding OkButtonText}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="DialogConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
