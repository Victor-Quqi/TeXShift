<Window x:Class="TeXShift.AddIn.UI.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TeXShift.AddIn.UI.WPF.Converters"
        Title="TeXShift 设置"
        Width="540" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/TeXShift.AddIn;component/Resources/TeXShift.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Purple"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

            <Style x:Key="SettingsLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="100"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- 小型按钮样式 -->
            <Style x:Key="SmallOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl Grid.Row="0" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <!-- Style Tab -->
            <TabItem Header="样式">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                    <StackPanel>
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="引用块" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" Height="28" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding QuoteBlockBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="选择..." Click="PickQuoteBlockBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="标题字号 (pt)" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8">
                                        <TextBlock Text="H1"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H1FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H1FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="H2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H2FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H2FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,8">
                                        <TextBlock Text="H3"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H3FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H3FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="H4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H4FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H4FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="H5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H5FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H5FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="H6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="140" Minimum="8" Maximum="36" Value="{Binding H6FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Text="{Binding H6FontSize, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Code Block Tab -->
            <TabItem Header="代码块">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                    <StackPanel>
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="代码块" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" Height="28" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding CodeBlockBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="选择..." Click="PickCodeBlockBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文字颜色" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" Height="28" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding CodeBlockTextColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="选择..." Click="PickCodeBlockTextColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字体" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding CodeBlockFontFamily}"
                                              Width="180" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字号" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="8" Maximum="24" Value="{Binding CodeBlockFontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CodeBlockFontSize, StringFormat={}{0:F1} pt}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="行距" Style="{StaticResource SettingsLabel}"/>
                                    <Slider Grid.Column="1" Minimum="12" Maximum="36" Value="{Binding CodeBlockSpaceBetween}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CodeBlockSpaceBetween, StringFormat={}{0:F1} pt}" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                                </Grid>

                                <CheckBox Content="启用语法高亮" IsChecked="{Binding EnableSyntaxHighlight}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="内联代码" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource SettingsLabel}"/>
                                    <Border Grid.Column="1" Width="50" Height="28" CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding InlineCodeBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="选择..." Click="PickInlineCodeBgColor_Click" Style="{StaticResource SmallOutlinedButton}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字体" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding InlineCodeFontFamily}"
                                              Width="180" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Debug Tab -->
            <TabItem Header="调试">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                    <materialDesign:Card Padding="16">
                        <StackPanel>
                            <CheckBox Content="显示调试按钮 (调试转换、查看XML)" IsChecked="{Binding ShowDebugButtons}" Margin="0,0,0,12"/>
                            <CheckBox Content="导出 PDF 到调试输出目录" IsChecked="{Binding ExportPdf}" Margin="0,0,0,16"/>
                            <TextBlock Text="调试输出目录 (留空使用默认):" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DebugOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="浏览..." Click="BrowseFolder_Click"
                                        Style="{StaticResource SmallOutlinedButton}"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="恢复默认" Click="ResetButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
